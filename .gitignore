# Secrets — never commit. .env.example documents every variable (CLAUDE.md rule 16).
.env
.env.*
!.env.example

# Run artifacts
out/

# Measured calibration (amendment J). Machine-specific: it is bound to the
# embedding model tag and the corpus hash it was measured against, and a
# committed copy would be loaded on a machine whose model may differ. Produced
# by `make calibrate`, which `make ingest` runs as its final step.
fixtures/calibration.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Docker volume data (named volumes live in the Docker VM, but bind-mount
# strays and local dumps land here)
volumes/
*.dump

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
