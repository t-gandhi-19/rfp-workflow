  "users": [
    {
      "username": "service-account-triage-sa",
      "enabled": true,
      "serviceAccountClientId": "triage-sa",
      "realmRoles": ["rfp-reader"]
    },
    {
      "username": "service-account-extractor-sa",
      "enabled": true,
      "serviceAccountClientId": "extractor-sa",
      "realmRoles": ["rfp-reader"]
    },
    {
      "username": "service-account-retriever-sa",
      "enabled": true,
      "serviceAccountClientId": "retriever-sa",
      "realmRoles": ["rfp-reader", "kg-reader"]
    },
    {
      "username": "service-account-drafter-sa",
      "enabled": true,
      "serviceAccountClientId": "drafter-sa",
      "realmRoles": ["rfp-reader", "kg-reader", "draft-writer"]
    },
    {
      "username": "service-account-critic-sa",
      "enabled": true,
      "serviceAccountClientId": "critic-sa",
      "realmRoles": ["rfp-reader", "kg-reader"]
    },
    {
      "username": "service-account-assembler-sa",
      "enabled": true,
      "serviceAccountClientId": "assembler-sa",
      "realmRoles": ["rfp-reader", "kg-reader", "draft-writer"]
    },
    {
      "username": "service-account-ingest-sa",
      "enabled": true,
      "serviceAccountClientId": "ingest-sa",
      "realmRoles": ["kg-reader", "kg-writer"]
    },
    {
      "username": "service-account-evals-sa",
      "enabled": true,
      "serviceAccountClientId": "evals-sa",
      "realmRoles": ["rfp-reader", "kg-reader", "draft-writer"]
    },
    {
      "username": "service-account-dashboard-sa",
      "enabled": true,
      "serviceAccountClientId": "dashboard-sa",
      "realmRoles": ["rfp-reader", "log-reader", "view-events"],
      "clientRoles": {
        "realm-management": ["view-events", "view-users"]
      }
    },
    {
      "username": "service-account-loginterp-sa",
      "enabled": true,
      "serviceAccountClientId": "loginterp-sa",
      "realmRoles": ["rfp-reader", "log-reader"]
    }
  ]
}
