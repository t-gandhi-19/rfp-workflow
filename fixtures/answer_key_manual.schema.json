{
  "$defs": {
    "ManualQuestion": {
      "additionalProperties": false,
      "description": "One question as a human read it off the rendered document.",
      "properties": {
        "expected_best_match_answer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Best Match Answer Id"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "number": {
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "section": {
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "word_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Limit"
        }
      },
      "required": [
        "order",
        "number",
        "section",
        "text",
        "mandatory"
      ],
      "title": "ManualQuestion",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hand-written ground truth for the extraction evals. Written by a human reading fixtures/golden_rfp.pdf. Never generated by tooling.",
  "properties": {
    "authored_by": {
      "minLength": 1,
      "title": "Authored By",
      "type": "string"
    },
    "authored_on": {
      "minLength": 1,
      "title": "Authored On",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "issuer": {
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/ManualQuestion"
      },
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "rfp_reference": {
      "minLength": 1,
      "title": "Rfp Reference",
      "type": "string"
    },
    "source_document": {
      "minLength": 1,
      "title": "Source Document",
      "type": "string"
    }
  },
  "required": [
    "source_document",
    "rfp_reference",
    "issuer",
    "authored_by",
    "authored_on",
    "questions"
  ],
  "title": "rfp-workflow manual answer key",
  "type": "object"
}
